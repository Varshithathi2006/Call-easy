# Server Configuration
PORT=3000

# Twilio Credentials
# Your Account SID from Twilio Console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Virtual Phone Number (Must be purchased in Twilio Console)
# Format: +1XXXXXXXXXX or +91XXXXXXXXXX
TWILIO_PHONE_NUMBER=+15707474371

# Twilio WhatsApp Sender Number (Sandbox: +14155238886, or verified WhatsApp sender)
TWILIO_WHATSAPP_NUMBER=+14155238886

# Recruiter Personal Phone Number (Twilio calls this number first, then bridges call)
RECRUITER_PHONE_NUMBER=+919360445442

# Server Base URL (Public URL required for Twilio TwiML webhooks, e.g. ngrok domain)
# Example: https://abc12345.ngrok-free.app or http://localhost:3000 for local testing
SERVER_BASE_URL=http://localhost:3000

# Email SMTP Settings (Nodemailer / SendGrid / Gmail / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Recruiter <your_email@gmail.com>"
